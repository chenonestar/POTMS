@page "/Decontrol"
@model POTMS.Pages.Decontrol.IndexModel
@inject POTMS.Data.Db Database
@{
    ViewData["Title"] = "撤控备案";
    using var cn = Database.Open();
    string DV(string? c) => POTMS.Services.Helpers.GetDictValue(cn, "submit_unit_type", c);
}
<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h4><i class="bi bi-arrow-repeat"></i> 因私事出国（境）人员撤控备案</h4>
    <div>
        <button type="button" class="btn btn-outline-success" onclick="batchPrint('decontrol')"><i class="bi bi-printer"></i> 批量打印</button>
        <div class="dropdown d-inline-block ms-1">
            <button class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" type="button"><i class="bi bi-file-earmark-excel"></i> 导出</button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="exportFiltered('/Export/Decontrol');return false;">按当前筛选导出</a></li>
                <li><a class="dropdown-item" href="#" onclick="exportSelected('/Export/Decontrol');return false;">导出选中行</a></li>
                <li><a class="dropdown-item" href="/Export/Decontrol">全量导出</a></li>
            </ul>
        </div>
    </div>
</div>
<p class="text-muted small">撤控从「人员备案」列表对在案记录发起。撤控后如需重报，新建备案表时系统会自动与原记录建立关联。</p>

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3"><input type="text" class="form-control form-control-sm" name="search" placeholder="姓名 / 身份证 / 工作单位" value="@Model.Search"></div>
        <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="batch" placeholder="入库批号" value="@Model.BatchFilter"></div>
        <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">筛选</button><a href="/Decontrol" class="btn btn-sm btn-outline-secondary">重置</a></div>
    </form>
</div></div>

<div class="table-card"><div class="table-responsive">
<table id="mainTable" class="table table-hover mb-0">
    <thead class="table-light"><tr>
        <th style="width:30px"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" title="全选"></th>
        <th>姓名</th><th>身份证号</th><th>工作单位</th><th>报送单位</th><th>类别</th>
        <th>入库批号</th><th>撤控日期</th><th>证件移交</th><th>操作</th>
    </tr></thead>
    <tbody>
    @foreach (var r in Model.Items.Rows)
    {
        <tr>
            <td><input type="checkbox" class="row-check" value="@r.Id"></td>
            <td>@r.Name</td><td><small>@r.IdNumber</small></td><td>@r.WorkUnit</td>
            <td>@r.SubmitUnitName</td><td>@DV(r.SubmitUnitType)</td>
            <td>@r.BatchNo</td><td>@(r.DecontrolDate ?? "-")</td><td>@(r.CertHandoverDate ?? "-")</td>
            <td><div class="btn-group btn-group-sm">
                <a href="/Decontrol/View/@r.Id" class="btn btn-outline-info" title="查看"><i class="bi bi-eye"></i></a>
                <a href="/Print/decontrol/@r.Id" class="btn btn-outline-secondary" title="打印" target="_blank"><i class="bi bi-printer"></i></a>
            </div></td>
        </tr>
    }
    @if (Model.Items.Total == 0)
    { <tr><td colspan="10" class="text-center text-muted py-4">暂无撤控记录</td></tr> }
    </tbody>
</table>
</div></div>
