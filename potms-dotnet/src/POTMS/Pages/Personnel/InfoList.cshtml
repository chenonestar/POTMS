@page "/Personnel/InfoList"
@model POTMS.Pages.Personnel.InfoListModel
@inject POTMS.Data.Db Database
@{
    ViewData["Title"] = "信息登记表管理";
    using var cn = Database.Open();
    string DV(string cat, string? code) => POTMS.Services.Helpers.GetDictValue(cn, cat, code);
}
<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h4><i class="bi bi-list-columns"></i> 信息登记表管理</h4>
    <div>
        <a href="/Personnel/InfoForm" class="btn btn-primary"><i class="bi bi-plus-lg"></i> 新增</a>
        <div class="dropdown d-inline-block ms-1">
            <button class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" type="button"><i class="bi bi-file-earmark-excel"></i> 导出</button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="exportFiltered('/Export/Info');return false;">按当前筛选导出</a></li>
                <li><a class="dropdown-item" href="/Export/Info">全量导出</a></li>
            </ul>
        </div>
        <a href="/Personnel" class="btn btn-outline-secondary ms-1">返回备案列表</a>
    </div>
</div>

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3"><input type="text" class="form-control form-control-sm" name="search" placeholder="姓名 / 身份证 / 单位 / 部门" value="@Model.Search"></div>
        <div class="col-md-2"><select class="form-select form-select-sm" name="ref">
            <option value="">全部</option>
            <option value="orphan" selected="@(Model.RefFilter == "orphan")">仅孤儿（无引用）</option>
            <option value="linked" selected="@(Model.RefFilter == "linked")">仅有引用</option>
        </select></div>
        <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">筛选</button><a href="/Personnel/InfoList" class="btn btn-sm btn-outline-secondary">重置</a></div>
    </form>
</div></div>

<div class="table-card"><div class="table-responsive">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr>
        <th>单位</th><th>部门</th><th>姓名</th><th>性别</th><th>身份证号</th>
        <th>学历</th><th>职务</th><th>关联备案数</th><th>操作</th>
    </tr></thead>
    <tbody>
    @foreach (var r in Model.Items.Rows)
    {
        <tr class="@(r.FilingCount == 0 ? "table-warning" : "")">
            <td>@r.Unit</td><td>@r.Department</td><td>@r.Name</td><td>@r.Gender</td>
            <td><small>@r.IdNumber</small></td>
            <td>@DV("education", r.Education)</td><td>@r.Position</td>
            <td>@(r.FilingCount == 0
                    ? Html.Raw("<span class=\"badge bg-warning text-dark\">0（孤儿）</span>")
                    : Html.Raw($"<span class=\"badge bg-success\">{r.FilingCount}</span>"))</td>
            <td><div class="btn-group btn-group-sm">
                <a href="/Print/info/@r.Id" class="btn btn-outline-secondary" title="打印" target="_blank"><i class="bi bi-printer"></i></a>
                <a href="/Personnel/InfoForm?id=@r.Id" class="btn btn-outline-warning" title="编辑"><i class="bi bi-pencil"></i></a>
                @if (r.FilingCount == 0)
                {
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmModal"
                            data-action="/Personnel/InfoList?handler=Delete&amp;id=@r.Id"
                            data-message="确定要删除 @r.Name 的信息登记表吗？该记录无任何备案引用。"><i class="bi bi-trash"></i></button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary" disabled title="已被 @r.FilingCount 条备案引用，不能删除"><i class="bi bi-trash"></i></button>
                }
            </div></td>
        </tr>
    }
    @if (Model.Items.Total == 0)
    {
        <tr><td colspan="9" class="text-center text-muted py-4">暂无信息登记表</td></tr>
    }
    </tbody>
</table>
</div></div>
<partial name="_Pagination" model="Model.Pager" />
<partial name="_ConfirmModal" />
