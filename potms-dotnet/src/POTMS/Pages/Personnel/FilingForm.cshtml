@page "/Personnel/FilingForm"
@model POTMS.Pages.Personnel.FilingFormModel
@inject POTMS.Data.Db Database
@{
    ViewData["Title"] = "登记备案表";
    using var cn = Database.Open();
    var polit = POTMS.Services.Helpers.GetDictOptions(cn, "political_status");
    var supers = POTMS.Services.Helpers.GetDictOptions(cn, "supervisor_unit");
    var orgs = POTMS.Services.Helpers.GetOrgTreeOptions(cn);
    string V(string k) => Model.Data.TryGetValue(k, out var v) ? v ?? "" : "";
    var draftAttr = Model.Editing ? null : "filing";
}
<h4 class="mb-3 mt-3"><i class="bi bi-file-earmark-person"></i> @(Model.Editing ? "编辑" : "新增")因私事出国（境）人员登记备案表</h4>

<form method="post" class="needs-validation" novalidate data-draft="@draftAttr">
<div class="form-section"><h5>姓名与身份</h5>
    <p class="text-muted small mb-2">复姓请正确拆分（欧阳、司马、上官、诸葛、令狐、皇甫、尉迟、长孙、宇文、慕容、夏侯、东方）。</p>
    <div class="row g-3">
        <div class="col-md-2"><label class="form-label required">中文姓</label>
            <input type="text" class="form-control" name="surname" value="@V("surname")" required></div>
        <div class="col-md-2"><label class="form-label required">中文名</label>
            <input type="text" class="form-control" name="given_name" value="@V("given_name")" required></div>
        <div class="col-md-2"><label class="form-label required">性别</label>
            <select class="form-select" name="gender" required>
                <option value="">请选择</option>
                <option value="男" selected="@(V("gender") == "男")">男</option>
                <option value="女" selected="@(V("gender") == "女")">女</option>
            </select></div>
        <div class="col-md-3"><label class="form-label required">出生日期</label>
            <input type="text" class="form-control" name="birth_date" value="@V("birth_date")" placeholder="YYYYMMDD" maxlength="8" required></div>
        <div class="col-md-3"><label class="form-label required">身份证号</label>
            <input type="text" class="form-control" name="id_number" value="@V("id_number")" maxlength="18" required></div>
    </div>
</div>

<div class="form-section"><h5>户口与单位</h5><div class="row g-3">
    <div class="col-md-6"><label class="form-label required">户口所在地</label>
        <input type="text" class="form-control" name="residence" id="residence" value="@V("residence")" required>
        <div class="form-text">省份不加「省」字，填至区级；江东区 / 鄞县统一映射为「浙江宁波市鄞州区」。</div></div>
    <div class="col-md-3"><label class="form-label required">政治面貌</label>
        <select class="form-select" name="political_status" required>
            <option value="">请选择</option>
            @foreach (var o in polit)
            { <option value="@o.Value" selected="@(V("political_status") == o.Value)">@o.Value</option> }
        </select></div>
    <div class="col-md-3"><label class="form-label required">工作单位</label>
        <input type="text" class="form-control" name="work_unit" value="@V("work_unit")" list="orgList" required>
        <datalist id="orgList">@foreach (var o in orgs) { <option value="@o.Name"></option> }</datalist></div>
</div><div class="row g-3 mt-1">
    <div class="col-md-4"><label class="form-label required">职务（级）或职称</label>
        <input type="text" class="form-control" name="position_or_title" value="@V("position_or_title")" required></div>
    <div class="col-md-4"><label class="form-label required">人事主管单位</label>
        <input type="text" class="form-control" name="supervisor_unit" value="@V("supervisor_unit")" list="supList" required>
        <datalist id="supList">@foreach (var o in supers) { <option value="@o.Value"></option> }</datalist></div>
    <div class="col-md-2"><label class="form-label required">标记</label>
        <select class="form-select" name="tag" required>
            @foreach (var t in new[] { "新增", "变更", "更新" })
            { <option value="@t" selected="@(V("tag") == t)">@t</option> }
        </select></div>
    <div class="col-md-2"><label class="form-label required">已告知本人</label>
        <select class="form-select" name="informed" required>
            <option value="否" selected="@(V("informed") == "否")">否</option>
            <option value="是" selected="@(V("informed") == "是")">是</option>
        </select></div>
</div><div class="row g-3 mt-1">
    <div class="col-md-12"><label class="form-label">备注</label>
        <input type="text" class="form-control" name="remarks" value="@V("remarks")"></div>
</div></div>

<div class="mt-3">
    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> 保存</button>
    <a href="/Personnel" class="btn btn-secondary">取消</a>
</div>
</form>
