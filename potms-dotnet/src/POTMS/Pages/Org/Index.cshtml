@page "/Org"
@model POTMS.Pages.Org.IndexModel
@{ ViewData["Title"] = "组织架构"; }
<h4 class="mb-3 mt-3"><i class="bi bi-diagram-3"></i> 组织架构</h4>

<div class="row">
<div class="col-md-7">
<div class="table-card"><div class="table-responsive">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>层级名称</th><th>上级</th><th>排序</th><th>引用</th><th>操作</th></tr></thead>
    <tbody>
    @foreach (var o in Model.Tree)
    {
        var node = Model.Flat.First(x => x.Id == o.Id);
        var parent = Model.Flat.FirstOrDefault(x => x.Id == node.ParentId);
        var usage = Model.UsageCount.TryGetValue(o.Id, out var u) ? u : 0;
        <tr>
            <td>@o.Label</td>
            <td class="text-muted small">@(parent?.Name ?? "（顶级）")</td>
            <td>@node.SortOrder</td>
            <td>@(usage == 0 ? Html.Raw("<span class=\"text-muted\">0</span>") : Html.Raw($"<span class=\"badge bg-secondary\">{usage}</span>"))</td>
            <td><div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-warning" title="编辑"
                        onclick="orgEdit(@o.Id, '@node.Name', @node.ParentId, @node.SortOrder)"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmModal"
                        data-action="/Org?handler=Delete&amp;id=@o.Id" data-message="确定要删除组织节点「@node.Name」吗？"><i class="bi bi-trash"></i></button>
            </div></td>
        </tr>
    }
    @if (Model.Tree.Count == 0)
    { <tr><td colspan="5" class="text-center text-muted py-4">暂无组织节点</td></tr> }
    </tbody>
</table>
</div></div>
</div>

<div class="col-md-5">
<div class="form-section">
    <h5 id="orgFormTitle">新增组织节点</h5>
    <form method="post" asp-page-handler="Save">
        <input type="hidden" name="id" id="orgId">
        <div class="mb-3"><label class="form-label required">名称</label>
            <input type="text" class="form-control" name="name" id="orgName" required></div>
        <div class="mb-3"><label class="form-label">上级</label>
            <select class="form-select" name="parentId" id="orgParent">
                <option value="0">（顶级）</option>
                @foreach (var o in Model.Tree) { <option value="@o.Id">@o.Label</option> }
            </select></div>
        <div class="mb-3"><label class="form-label">排序</label>
            <input type="number" class="form-control" name="sortOrder" id="orgSort" value="0"></div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> 保存</button>
        <button type="button" class="btn btn-secondary" onclick="orgReset()">清空</button>
    </form>
</div>
</div>
</div>
<partial name="_ConfirmModal" />

@section Scripts {
<script>
function orgEdit(id, name, parentId, sort) {
    document.getElementById('orgId').value = id;
    document.getElementById('orgName').value = name;
    document.getElementById('orgParent').value = parentId;
    document.getElementById('orgSort').value = sort;
    document.getElementById('orgFormTitle').textContent = '编辑组织节点 #' + id;
}
function orgReset() {
    document.getElementById('orgId').value = '';
    document.getElementById('orgName').value = '';
    document.getElementById('orgParent').value = '0';
    document.getElementById('orgSort').value = '0';
    document.getElementById('orgFormTitle').textContent = '新增组织节点';
}
</script>
}
