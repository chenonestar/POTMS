@page
@model POTMS.Pages.IndexModel
@{
    ViewData["Title"] = "首页仪表盘";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h4><i class="bi bi-speedometer2"></i> 首页仪表盘</h4>
    <div class="d-flex align-items-center">
        @if (Model.BackupDate.Length > 0)
        {
            <small class="text-muted me-2">最近备份：@Model.BackupDate</small>
        }
        <form method="post" asp-page-handler="BackupNow" class="m-0">
            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-hdd"></i> 立即备份</button>
        </form>
    </div>
</div>

@* 姓名没填时提示一次。不强制、不挡流程——只是提醒单据上会显示登录账号。 *@
@{
    var _acct = User.Identity?.Name ?? "";
    var _name = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "";
}
@if (_name.Length == 0 || _name == _acct)
{
<div class="alert alert-warning alert-dismissible fade show py-2 small" role="alert">
    <i class="bi bi-person-exclamation"></i>
    尚未填写<strong>姓名</strong>，证件领用等单据与打印件上的「经办人」会显示登录账号
    「@_acct」。
    <a href="/Account" class="alert-link">去账户设置补全</a>。
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<div class="row mb-4">
    <div class="col-md-3">
        <a href="/Personnel" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-primary">@Model.TotalActive</div>
            <small class="text-muted">在案备案人员 <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
    <div class="col-md-3">
        <a href="/Decontrol" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-secondary">@Model.TotalDecontrolled</div>
            <small class="text-muted">已撤控 <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
    <div class="col-md-3">
        <a href="/Certificate" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-info">@Model.TotalCertificates</div>
            <small class="text-muted">证照登记 <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
    <div class="col-md-3">
        <a href="/Travel" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-success">@Model.TotalTravel</div>
            <small class="text-muted">出国申请 <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4"><div class="card text-center"><div class="card-body py-3">
        <div class="fs-4 fw-bold text-success">@Model.CertInStorage</div>
        <small class="text-muted">证照在库</small>
    </div></div></div>
    <div class="col-md-4">
        <a href="/Travel?passportStatus=in_use" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-primary">@Model.CertInUse</div>
            <small class="text-muted">证照借出（已领未还） <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
    <div class="col-md-4">
        <a href="/Travel?passportStatus=overdue" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-danger">@Model.CertOverdue</div>
            <small class="text-muted">证照逾期未还 <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <a href="/Issuance?status=issued" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-warning">@Model.IssPending</div>
            <small class="text-muted">已领用待归还 <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
    <div class="col-md-4">
        <a href="/Issuance" class="text-decoration-none"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-primary">@Model.IssThisMonth</div>
            <small class="text-muted">本月证件领用 <i class="bi bi-chevron-right small"></i></small>
        </div></div></a>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100"><div class="card-header bg-white"><strong><i class="bi bi-exclamation-triangle text-danger"></i> 证件逾期未还</strong></div>
        <div class="card-body p-0"><div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>姓名</th><th>单位</th><th>应还日期</th></tr></thead>
                <tbody>
                @foreach (var o in Model.Overdue)
                {
                    <tr><td>@o.Name</td><td>@o.Unit</td><td class="text-danger">@o.Deadline</td></tr>
                }
                @if (Model.Overdue.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">无逾期记录</td></tr>
                }
                </tbody>
            </table>
        </div></div></div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card h-100"><div class="card-header bg-white"><strong><i class="bi bi-clock-history text-warning"></i> 证照即将到期（30天内）</strong></div>
        <div class="card-body p-0"><div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>姓名</th><th>证件</th><th>到期日</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Expiring)
                {
                    <tr><td>@e.Name</td><td>@e.Label</td><td class="text-warning">@e.Expiry</td></tr>
                }
                @if (Model.Expiring.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">无即将到期证照</td></tr>
                }
                </tbody>
            </table>
        </div></div></div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white"><strong><i class="bi bi-airplane"></i> 最近出行</strong></div>
    <div class="card-body p-0"><div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>姓名</th><th>地点、证照</th><th>计划出行日期</th></tr></thead>
            <tbody>
            @foreach (var t in Model.RecentTravel)
            {
                <tr><td>@t.Name</td><td>@t.Destination</td><td>@t.TravelDates</td></tr>
            }
            @if (Model.RecentTravel.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted py-3">暂无出行记录</td></tr>
            }
            </tbody>
        </table>
    </div></div>
</div>
