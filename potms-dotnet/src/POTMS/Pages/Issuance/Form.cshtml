@page "/Issuance/Form"
@model POTMS.Pages.Issuance.FormModel
@inject POTMS.Data.Db Database
@{
    ViewData["Title"] = "证件领用登记";
    using var cn = Database.Open();
    var types = POTMS.Services.Helpers.GetDictOptions(cn, "cert_type");
    var persons = POTMS.Services.Helpers.GetPersonnelOptions(cn);
    string V(string k) => Model.Data.TryGetValue(k, out var v) ? v ?? "" : "";
    var locked = Model.Travel is not null;
}
<h4 class="mb-3 mt-3"><i class="bi bi-vector-pen"></i> 证件领用登记</h4>

@if (Model.Travel is not null)
{
    <div class="alert alert-info py-2">
        <i class="bi bi-airplane"></i> 关联出行记录 #@Model.Travel.Id：
        <strong>@Model.Travel.Name</strong> · @Model.Travel.DestinationPassport · 计划出行 @Model.Travel.TravelDates
        @if (!string.IsNullOrEmpty(Model.Travel.ApprovalDate)) { <text>· 批准日期 @Model.Travel.ApprovalDate</text> }
    </div>
}

<form method="post" id="signForm" class="needs-validation" novalidate>
<input type="hidden" name="travel_id" value="@V("travel_id")">

<div class="form-section">
    <h5>领用人</h5>
    <p class="text-muted small mb-2">选择备案人员后，姓名 / 身份证号自动带入；勾选证件种类后自动填入已登记的证件号码。</p>
    <div class="row g-3">
        <div class="col-md-5">
            <label class="form-label">搜索备案人员</label>
            <input type="text" class="form-control" id="personSearch" placeholder="输入姓名 / 身份证号 / 单位 过滤"
                   oninput="filterPersons('personSearch','personSelect')" autocomplete="off">
        </div>
        <div class="col-md-5">
            <label class="form-label required">备案人员</label>
            <select class="form-select" name="personnel_filing_id" id="personSelect" required size="6" data-locked="@(locked ? "1" : "")">
                <option value="">请选择备案人员</option>
                @foreach (var p in persons)
                {
                    <option value="@p.Id"
                            data-name="@p.Name"
                            data-idno="@p.IdNumber"
                            data-cert01="@(p.CertByType.TryGetValue("01", out var c1) ? c1 : "")"
                            data-cert02="@(p.CertByType.TryGetValue("02", out var c2) ? c2 : "")"
                            data-cert03="@(p.CertByType.TryGetValue("03", out var c3) ? c3 : "")"
                            data-search="@((p.Name + p.IdNumber + p.Unit).ToLowerInvariant())"
                            selected="@(V("personnel_filing_id") == p.Id.ToString())">@p.FullName</option>
                }
            </select>
        </div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-3"><label class="form-label required">领用人姓名</label>
            <input type="text" class="form-control" name="holder_name" id="holderName" value="@V("holder_name")" required readonly></div>
        <div class="col-md-3"><label class="form-label">身份证号 <span class="text-muted">(自动带入)</span></label>
            <input type="text" class="form-control" name="id_number" id="holderIdNo" value="@V("id_number")" readonly></div>
    </div>
</div>

<div class="form-section">
    <h5>领用证件</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label required">证件种类（可多选）</label>
            <div>
                @foreach (var o in types)
                {
                    <div class="form-check">
                        <input class="form-check-input cert-type" type="checkbox" name="cert_types" value="@o.Code" id="ct@(o.Code)"
                               checked="@Model.SelectedTypes.Contains(o.Code)">
                        <label class="form-check-label" for="ct@(o.Code)">@o.Value</label>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label">证件号码 <span class="text-muted">(按勾选种类自动带入，可修改)</span></label>
            <input type="text" class="form-control" name="cert_nos" id="certNos" value="@V("cert_nos")" placeholder="多本证件以顿号分隔">
            <div class="form-text">号码会随记录固化保存，后续修改证照信息不影响本次领用凭证。</div>
        </div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-3"><label class="form-label required">领用日期</label>
            <input type="text" class="form-control" name="issue_date" value="@V("issue_date")" placeholder="YYYYMMDD" maxlength="8" required></div>
        <div class="col-md-3"><label class="form-label">经办人（发放人）</label>
            <input type="text" class="form-control" value="@User.Identity?.Name" readonly></div>
        <div class="col-md-6"><label class="form-label">备注</label>
            <input type="text" class="form-control" name="remarks" value="@V("remarks")"></div>
    </div>
</div>

<div class="form-section">
    <h5>领用人签名</h5>
    <partial name="_SignaturePad" model="@("领用人手写签名")" />
</div>

<div class="mt-3">
    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> 保存领用登记</button>
    <a href="/Issuance" class="btn btn-secondary">取消</a>
</div>
</form>

@section Scripts {
<script src="~/js/signature.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var sel = document.getElementById('personSelect');
    var nameEl = document.getElementById('holderName');
    var idEl = document.getElementById('holderIdNo');
    var nosEl = document.getElementById('certNos');

    function syncCertNos() {
        var o = sel.options[sel.selectedIndex];
        if (!o || !o.value) return;
        var picked = [];
        document.querySelectorAll('.cert-type:checked').forEach(function (cb) {
            var no = o.getAttribute('data-cert' + cb.value);
            if (no) picked.push(no);
        });
        nosEl.value = picked.join('、');
    }
    function fillPerson() {
        var o = sel.options[sel.selectedIndex];
        if (!o || !o.value) { nameEl.value = ''; idEl.value = ''; return; }
        nameEl.value = o.getAttribute('data-name') || '';
        idEl.value = o.getAttribute('data-idno') || '';
        syncCertNos();
    }
    sel.addEventListener('change', fillPerson);
    document.querySelectorAll('.cert-type').forEach(function (cb) { cb.addEventListener('change', syncCertNos); });

    // 从出行记录带入时人员已确定，禁止改选以免与出行记录脱节
    if (sel.getAttribute('data-locked')) {
        sel.querySelectorAll('option').forEach(function (op) { if (!op.selected) op.disabled = true; });
    }

    POTMSSignature.attach({
        canvas: document.getElementById('signCanvas'),
        clearBtn: document.getElementById('signClear'),
        undoBtn: document.getElementById('signUndo'),
        pngInput: document.getElementById('signPng'),
        metaInput: document.getElementById('signMeta'),
        hintEl: document.getElementById('signHint'),
        form: document.getElementById('signForm')
    });
});
</script>
}
