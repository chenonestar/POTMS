@page "/Issuance"
@model POTMS.Pages.Issuance.IndexModel
@inject POTMS.Data.Db Database
@{
    ViewData["Title"] = "证件领用";
    using var cn = Database.Open();
    var types = POTMS.Services.Helpers.GetDictOptions(cn, "cert_type");
    string DV(string? code) => POTMS.Services.Helpers.GetDictValue(cn, "cert_type", code);
}
<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h4><i class="bi bi-vector-pen"></i> 证件领用登记</h4>
    <div>
        <a href="/Issuance/Form" class="btn btn-primary"><i class="bi bi-plus-lg"></i> 新增领用</a>
        <div class="dropdown d-inline-block ms-1">
            <button class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" type="button"><i class="bi bi-file-earmark-excel"></i> 导出</button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="exportFiltered('/Export/Issuance');return false;">按当前筛选导出</a></li>
                <li><a class="dropdown-item" href="#" onclick="exportSelected('/Export/Issuance');return false;">导出选中行</a></li>
                <li><a class="dropdown-item" href="/Export/Issuance">全量导出</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="search" placeholder="姓名 / 身份证 / 证件号" value="@Model.Search"></div>
        <div class="col-md-2"><select class="form-select form-select-sm" name="status">
            <option value="">全部状态</option>
            <option value="issued" selected="@(Model.StatusFilter == "issued")">已领用（未归还）</option>
            <option value="returned" selected="@(Model.StatusFilter == "returned")">已归还</option>
            <option value="voided" selected="@(Model.StatusFilter == "voided")">已作废</option>
        </select></div>
        <div class="col-md-2"><select class="form-select form-select-sm" name="certType">
            <option value="">全部证件种类</option>
            @foreach (var o in types)
            { <option value="@o.Code" selected="@(Model.CertTypeFilter == o.Code)">@o.Value</option> }
        </select></div>
        <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="dateFrom" placeholder="领用起始 YYYYMMDD" value="@Model.DateFrom"></div>
        <div class="col-md-2"><input type="text" class="form-control form-control-sm" name="dateTo" placeholder="领用截止 YYYYMMDD" value="@Model.DateTo"></div>
        <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">筛选</button><a href="/Issuance" class="btn btn-sm btn-outline-secondary">重置</a></div>
    </form>
</div></div>

<div class="table-card"><div class="table-responsive">
<table id="mainTable" class="table table-hover mb-0">
    <thead class="table-light"><tr>
        <th style="width:30px"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" title="全选"></th>
        <th>单位</th><th>领用人</th><th>证件种类</th><th>证件号码</th><th>领用日期</th>
        <th>归还日期</th><th>经办人</th><th>签名</th><th>状态</th><th>操作</th>
    </tr></thead>
    <tbody>
    @foreach (var r in Model.Items.Rows)
    {
        <tr class="@(r.Status == "voided" ? "text-muted" : "")">
            <td><input type="checkbox" class="row-check" value="@r.Id"></td>
            <td title="@r.WorkUnit">@r.WorkUnit</td>
            <td>@r.HolderName</td>
            <td>
                @foreach (var c in (r.CertTypes ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                { <span class="badge bg-light text-dark border">@DV(c)</span> }
            </td>
            <td><small>@(string.IsNullOrEmpty(r.CertNos) ? "-" : r.CertNos)</small></td>
            <td>@r.IssueDate</td>
            <td>@(string.IsNullOrEmpty(r.ReturnDate) ? "-" : r.ReturnDate)</td>
            <td>@r.Issuer</td>
            <td>
                @if (r.SignImage is { Length: > 0 })
                { <img src="/Issuance/Signature/@r.Id" alt="签名" style="height:28px;"> }
                else
                { <span class="text-muted small">无</span> }
            </td>
            <td>
                @if (r.Status == "issued") { <span class="badge bg-warning text-dark">已领用</span> }
                else if (r.Status == "returned") { <span class="badge bg-success">已归还</span> }
                else { <span class="badge bg-secondary">已作废</span> }
            </td>
            <td><div class="btn-group btn-group-sm">
                <a href="/Issuance/View/@r.Id" class="btn btn-outline-primary" title="详情"><i class="bi bi-eye"></i></a>
                <a href="/Print/issuance/@r.Id" class="btn btn-outline-secondary" title="打印" target="_blank"><i class="bi bi-printer"></i></a>
                @if (r.Status == "issued")
                {
                    <a href="/Issuance/Return/@r.Id" class="btn btn-outline-success" title="归还登记"><i class="bi bi-box-arrow-in-left"></i></a>
                }
            </div></td>
        </tr>
    }
    @if (Model.Items.Total == 0)
    {
        <tr><td colspan="11" class="text-center text-muted py-4">暂无领用记录</td></tr>
    }
    </tbody>
</table>
</div></div>
<partial name="_Pagination" model="Model.Pager" />
