@page "/Travel/Attachments"
@model POTMS.Pages.Travel.AttachmentsModel
@{ ViewData["Title"] = "附件总览"; }
<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h4><i class="bi bi-paperclip"></i> 附件总览</h4>
</div>

<div class="row mb-3">
    @foreach (var lbl in new[] { "个人申请报告", "审批表", "同意申办函" })
    {
        <div class="col-md-3"><div class="card text-center"><div class="card-body py-3">
            <div class="fs-4 fw-bold text-primary">@(Model.TypeCounts.TryGetValue(lbl, out var n) ? n : 0)</div>
            <small class="text-muted">@lbl</small>
        </div></div></div>
    }
    <div class="col-md-3"><div class="card text-center"><div class="card-body py-3">
        <div class="fs-4 fw-bold text-danger">@Model.Missing.Count</div>
        <small class="text-muted">缺件出行记录</small>
    </div></div></div>
</div>

@if (Model.Missing.Count > 0)
{
    <div class="alert alert-warning">
        <strong><i class="bi bi-exclamation-triangle-fill"></i> 以下出行记录缺少必传附件：</strong>
        <ul class="mb-0 mt-2">
        @foreach (var m in Model.Missing)
        {
            <li><a href="/Travel/Form?id=@m.Id">@m.Name（@m.Unit）</a>
                — 路径@m.Path，缺：<strong>@string.Join("、", m.Lack)</strong></li>
        }
        </ul>
    </div>
}

<div class="card mb-3"><div class="card-body py-2">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3"><input type="text" class="form-control form-control-sm" name="search" placeholder="姓名 / 单位" value="@Model.Search"></div>
        <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">筛选</button><a href="/Travel/Attachments" class="btn btn-sm btn-outline-secondary">重置</a></div>
    </form>
</div></div>

<div class="table-card"><div class="table-responsive">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>单位</th><th>姓名</th><th>计划出行日期</th><th>路径</th><th>附件数</th><th>操作</th></tr></thead>
    <tbody>
    @foreach (var r in Model.Items)
    {
        <tr>
            <td>@r.Unit</td><td>@r.Name</td><td>@r.TravelDates</td>
            <td>@(r.NeedNewPassport == "是" ? "B（需做证）" : "A（已有证件）")</td>
            <td>@(r.FileCount == 0 ? Html.Raw("<span class=\"badge bg-danger\">0</span>")
                                   : Html.Raw($"<span class=\"badge bg-success\">{r.FileCount}</span>"))</td>
            <td><a href="/Travel/View/@r.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> 查看</a></td>
        </tr>
    }
    @if (Model.Items.Count == 0)
    { <tr><td colspan="6" class="text-center text-muted py-4">暂无出行记录</td></tr> }
    </tbody>
</table>
</div></div>
