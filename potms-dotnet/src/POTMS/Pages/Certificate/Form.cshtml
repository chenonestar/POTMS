@page "/Certificate/Form"
@model POTMS.Pages.Certificate.FormModel
@inject POTMS.Data.Db Database
@{
    ViewData["Title"] = "证照登记表";
    using var cn = Database.Open();
    var persons = POTMS.Services.Helpers.GetPersonnelOptions(cn);
    string V(string k) => Model.Data.TryGetValue(k, out var v) ? v ?? "" : "";
    var draftAttr = Model.Editing ? null : "certificate";
}
<h4 class="mb-3 mt-3"><i class="bi bi-card-checklist"></i> @(Model.Editing ? "编辑" : "新增")因私出国（境）备案人员证照登记表</h4>

<form method="post" class="needs-validation" novalidate data-draft="@draftAttr">
<div class="form-section">
    <h5>选择备案人员</h5>
    <p class="text-muted small mb-2">选择人员后，单位 / 姓名自动从备案信息带入。</p>
    <div class="row g-3">
        <div class="col-md-5"><label class="form-label">搜索备案人员</label>
            <input type="text" class="form-control" id="personSearch" placeholder="输入姓名 / 身份证号 / 单位 过滤"
                   oninput="filterPersons('personSearch','personSelect')" autocomplete="off"></div>
        <div class="col-md-5"><label class="form-label required">备案人员</label>
            <select class="form-select" name="personnel_filing_id" id="personSelect" required size="6">
                <option value="">请选择备案人员</option>
                @foreach (var p in persons)
                {
                    <option value="@p.Id" data-unit="@p.Unit" data-dept="@p.Department" data-name="@p.Name"
                            data-search="@((p.Name + p.IdNumber + p.Unit).ToLowerInvariant())"
                            selected="@(V("personnel_filing_id") == p.Id.ToString())">@p.FullName</option>
                }
            </select></div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-3"><label class="form-label required">单位 <span class="text-muted">(自动带入)</span></label>
            <input type="text" class="form-control" name="unit" id="certUnit" value="@V("unit")" required readonly></div>
        <div class="col-md-3"><label class="form-label required">部门 <span class="text-muted">(自动带入)</span></label>
            <input type="text" class="form-control" name="department" id="certDept" value="@V("department")" required></div>
        <div class="col-md-3"><label class="form-label required">姓名 <span class="text-muted">(自动带入)</span></label>
            <input type="text" class="form-control" name="name" id="certName" value="@V("name")" required readonly></div>
    </div>
</div>

@foreach (var (no, exp, sub, label) in POTMS.Pages.Certificate.FormModel.CertGroups)
{
    var title = label == "护照" ? "普通护照" : label == "港澳通行证" ? "往来港澳通行证" : "大陆居民往来台湾通行证";
    <div class="form-section"><h5>@title</h5><div class="row g-3">
        <div class="col-md-4"><label class="form-label">证件号</label>
            <input type="text" class="form-control" name="@no" value="@V(no)"></div>
        <div class="col-md-4"><label class="form-label">有效日期</label>
            <input type="text" class="form-control" name="@exp" value="@V(exp)" placeholder="YYYYMMDD" maxlength="8"></div>
        <div class="col-md-4"><label class="form-label">上交日期</label>
            <input type="text" class="form-control" name="@sub" value="@V(sub)" placeholder="YYYYMMDD" maxlength="8"></div>
    </div></div>
}

<div class="mt-3">
    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> 保存</button>
    <a href="/Certificate" class="btn btn-secondary">取消</a>
</div>
</form>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    var sel = document.getElementById('personSelect');
    function fill() {
        var o = sel.options[sel.selectedIndex];
        if (!o || !o.value) return;
        document.getElementById('certUnit').value = o.getAttribute('data-unit') || '';
        document.getElementById('certName').value = o.getAttribute('data-name') || '';
        var dept = document.getElementById('certDept');
        if (!dept.value) dept.value = o.getAttribute('data-dept') || '';
    }
    sel.addEventListener('change', fill);
});
</script>
}
