@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@{
    var loggedIn = User.Identity?.IsAuthenticated == true;
    var username = User.Identity?.Name ?? "";
    var token = Xsrf.GetAndStoreTokens(Context).RequestToken ?? "";
    var navQ = Context.Request.Path.StartsWithSegments("/Search")
        ? Context.Request.Query["q"].ToString() : "";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="@token">
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " - 因私出国（境）人员审批管理系统" : "因私出国（境）人员审批管理系统")</title>
    <link href="~/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="~/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
@if (loggedIn)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
        <div class="container-fluid">
            <button class="btn btn-sm btn-outline-light border-0 d-md-none me-2" type="button" id="sidebarToggle" title="菜单">
                <i class="bi bi-list"></i>
            </button>
            <a class="navbar-brand" href="/"><i class="bi bi-passport"></i> 因私出国（境）审批管理</a>
            <div class="d-flex align-items-center">
                <form method="get" action="/Search" class="d-none d-md-flex me-3">
                    <div class="input-group input-group-sm" style="width:240px;">
                        <input type="text" class="form-control" name="q" value="@navQ" placeholder="全局搜索：姓名 / 身份证 / 证件号">
                        <button class="btn btn-outline-light" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>
                <div class="dropdown">
                    <a class="text-light dropdown-toggle text-decoration-none" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i> @username
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Account"><i class="bi bi-person-gear"></i> 账户设置</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="/Logout" class="m-0">
                                <input type="hidden" name="csrf_token" value="@token">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> 退出登录</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-speedometer2"></i> 首页仪表盘</a></li>
                    </ul>
                    <h6 class="sidebar-heading px-3 mt-4 mb-1 text-muted"><small>系统设置</small></h6>
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/Org"><i class="bi bi-diagram-3"></i> 组织架构</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Dict"><i class="bi bi-card-list"></i> 数据字典</a></li>
                        <li class="nav-item"><a class="nav-link" href="/SubmitUnit"><i class="bi bi-buildings"></i> 报送单位</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Account"><i class="bi bi-person-gear"></i> 账户设置</a></li>
                    </ul>
                    <h6 class="sidebar-heading px-3 mt-4 mb-1 text-muted"><small>数据管理</small></h6>
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/Import"><i class="bi bi-upload"></i> 批量导入</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Logs"><i class="bi bi-journal-text"></i> 操作日志</a></li>
                    </ul>
                    <h6 class="sidebar-heading px-3 mt-4 mb-1 text-muted"><small>业务功能</small></h6>
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/Personnel"><i class="bi bi-people"></i> 人员备案</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Certificate"><i class="bi bi-card-checklist"></i> 证照登记</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Travel"><i class="bi bi-airplane"></i> 出国（境）申请</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Issuance"><i class="bi bi-vector-pen"></i> 证件领用</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Travel/Attachments"><i class="bi bi-paperclip"></i> 附件总览</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Decontrol"><i class="bi bi-arrow-repeat"></i> 撤控备案</a></li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto px-md-4">
                <partial name="_Flash" />
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <partial name="_Flash" />
    @RenderBody()
}

<script src="~/vendor/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/js/main.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
