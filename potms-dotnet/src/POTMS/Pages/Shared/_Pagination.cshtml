@model POTMS.Pages.PaginationModel
@{
    if (Model.Pages <= 1) { return; }
    var start = Math.Max(Model.Page - 2, 1);
    var end = Math.Min(Model.Page + 2, Model.Pages);
    string Url(int p) => Model.PageUrl(p);
}
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
            <a class="page-link" href="@(Model.Page > 1 ? Url(Model.Page - 1) : "#")">上一页</a>
        </li>
        @if (start > 1)
        {
            <li class="page-item"><a class="page-link" href="@Url(1)">1</a></li>
            @if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
        }
        @for (var p = start; p <= end; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Url(p)">@p</a></li>
        }
        @if (end < Model.Pages)
        {
            @if (end < Model.Pages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            <li class="page-item"><a class="page-link" href="@Url(Model.Pages)">@Model.Pages</a></li>
        }
        <li class="page-item @(Model.Page >= Model.Pages ? "disabled" : "")">
            <a class="page-link" href="@(Model.Page < Model.Pages ? Url(Model.Page + 1) : "#")">下一页</a>
        </li>
    </ul>
</nav>
<div class="text-center text-muted small">共 @Model.Total 条记录，第 @Model.Page/@Model.Pages 页</div>
